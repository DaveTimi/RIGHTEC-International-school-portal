{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "noEmit": true,
    "isolatedModules": true,
    "resolveJsonModule": true,
    "skipLibCheck": true,
    "types": [
      "@cloudflare/workers-types"
    ]
  },
  "include": [
    "apps/**/*.ts",
    "apps/**/*.tsx",
    "functions/**/*.ts",
    "shared/**/*.ts",
    "tests/**/*.ts"
  ]
}
